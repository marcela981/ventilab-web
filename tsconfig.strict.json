/*
* Funcionalidad: Strict TypeScript configuration
* Descripción: Configuración de `npm run typecheck`: opciones estrictas sobre las carpetas de código nuevo. v0.1 (T1 Bloque 1): incluye playwright.config.ts y la carpeta e2e (arnés de Playwright y medición de rendimiento).
* Versión: 0.1
* Autor: Marcela Mazo Castro
* Proyecto: VentyLab
* Tesis: Desarrollo de una aplicación web para la enseñanza de mecánica ventilatoria que integre un sistema de retroalimentación usando modelos de lenguaje
* Institución: Universidad del Valle
* Contacto: marcela.mazo@correounivalle.edu.co
*/
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "incremental": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "e2e/**/*",
    "src/shared/api-client/**/*",
    "src/shared/realtime/**/*",
    "src/shared/session/**/*",
    "src/shared/design-system/**/*",
    "src/shared/layouts/**/*",
    "src/shared/rich-content/**/*",
    "src/shared/waveforms/**/*",
    "src/shared/charts/**/*",
    "src/shared/ai-rating/**/*",
    "src/shared/media-upload/**/*",
    "src/shared/ai-conversation/**/*",
    "src/shared/lib/**/*",
    "src/shared/sim-engine/**/*",
    "src/shared/ventilator-console/**/*",
    "src/shared/rubric-editor/**/*",
    "src/features/auth/api/**/*",
    "src/features/auth/application/**/*",
    "src/features/auth/index.ts",
    "src/features/profile/**/*",
    "src/features/groups/**/*",
    "src/features/learning/**/*",
    "src/features/content-editor/**/*",
    "src/features/evaluations/**/*",
    "src/features/evaluation-authoring/**/*",
    "src/features/grading/**/*",
    "src/features/ai-chat/**/*",
    "src/features/simulator/**/*",
    "src/features/case-editor/**/*",
    "src/features/ventilator-lab/**/*",
    "src/features/notifications/**/*",
    "src/features/student-space/**/*",
    "src/features/teacher-dashboard/**/*",
    "src/features/admin-console/**/*",
    "pages/auth/login/index.tsx",
    "pages/auth/register/index.tsx",
    "pages/auth/access-denied/index.tsx",
    "pages/auth/forgot-password/index.tsx",
    "pages/profile/index.tsx",
    "pages/my-group/index.tsx",
    "pages/groups/index.tsx",
    "pages/groups/[groupId].tsx",
    "pages/learn/index.tsx",
    "pages/learn/[sectionId].tsx",
    "pages/learn/modules/[moduleId]/index.tsx",
    "pages/learn/modules/[moduleId]/print.tsx",
    "pages/learn/modules/[moduleId]/lessons/[lessonId]/[pageNumber].tsx",
    "pages/content/index.tsx",
    "pages/content/pages/[pageId].tsx",
    "pages/evaluations/index.tsx",
    "pages/evaluations/[evaluationId]/index.tsx",
    "pages/evaluations/[evaluationId]/attempts/[attemptId]/index.tsx",
    "pages/evaluations/[evaluationId]/attempts/[attemptId]/result.tsx",
    "pages/evaluations/manage/index.tsx",
    "pages/evaluations/manage/new.tsx",
    "pages/evaluations/manage/[evaluationId]/edit.tsx",
    "pages/evaluations/manage/[evaluationId]/assignments.tsx",
    "pages/grading/index.tsx",
    "pages/grading/attempts/[attemptId].tsx",
    "pages/grading/evaluations/[evaluationId].tsx",
    "pages/assistant/index.tsx",
    "pages/assistant/[conversationId].tsx",
    "pages/simulator/index.tsx",
    "pages/simulator/sessions/[sessionId]/index.tsx",
    "pages/simulator/sessions/[sessionId]/result.tsx",
    "pages/simulator/sessions/[sessionId]/replay.tsx",
    "pages/simulator/cases/index.tsx",
