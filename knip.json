{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "pages/**/*.{js,jsx,ts,tsx}",
    "config/**/*.{mjs,d.mts}",
    "scripts/**/*.{js,mjs}"
  ],
  "project": [
    "pages/**/*.{js,jsx,ts,tsx}",
    "src/**/*.{js,jsx,ts,tsx,mjs}",
    "config/**/*.{mjs,mts}",
    "scripts/**/*.{js,mjs}"
  ],
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["src/**/*.{test,spec}.{ts,tsx}", "scripts/e2e/*.test.mjs"]
  },
  "ignore": [
    "src/shared/sim-engine/engine/**"
  ],
  "ignoreExportsUsedInFile": true
}
