# Funcionalidad: Variables de entorno de ejemplo de la web
# Descripción: Plantilla de .env.local con las variables que lee la web. v1.0 (A7): se retiran DATABASE_URL y
#   LOG_DB (la web ya no tiene Prisma; la base de datos pertenece al backend).
# Versión: 1.0
# Autor: Marcela Mazo Castro
# Proyecto: VentyLab
# Tesis: Desarrollo de una aplicación web para la enseñanza de mecánica ventilatoria que integre un sistema de retroalimentación usando modelos de lenguaje
# Institución: Universidad del Valle
# Contacto: marcela.mazo@correounivalle.edu.co

# =============================================================================
# VentyLab web — variables de entorno de ejemplo
# Copie este archivo como .env.local y complete los valores. NUNCA suba valores
# reales al repositorio.
#
# IMPORTANTE: toda variable con el prefijo NEXT_PUBLIC_ queda incrustada en el
# JavaScript que descarga el navegador y es visible para cualquier usuario.
# Los secretos (GOOGLE_CLIENT_SECRET, claves de API de IA, claves de servicio de
# Supabase, credenciales de base de datos, etc.) NUNCA deben llevar ese prefijo;
# además, este frontend no los necesita: viven solo en el backend.
# =============================================================================

# --- Backend (ventylab-server) ------------------------------------------------
# Origen del backend SIN el sufijo /api (las rutas del contrato OpenAPI ya lo
# incluyen). Lo usan el cliente HTTP, el streaming SSE, Socket.io y la CSP.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Variable heredada: solo se lee si NEXT_PUBLIC_BACKEND_URL está vacía; se le
# quita el sufijo /api. Puede dejarse vacía.
NEXT_PUBLIC_API_URL=

# Origen del backend para el renderizado en el servidor de Next (opcional; si
# está vacía se usa NEXT_PUBLIC_BACKEND_URL).
BACKEND_URL=

# --- Inicio de sesión con Google ----------------------------------------------
# ID de cliente OAuth de Google Identity Services (es público por diseño).
# Vacío: el botón de Google no se muestra y solo queda el ingreso con correo.
# El secreto del cliente de Google NO va aquí: lo usa únicamente el backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Archivos multimedia -------------------------------------------------------
# Origen de las URL firmadas de los archivos (Supabase Storage), por ejemplo
# https://<proyecto>.supabase.co. Se agrega a img-src y media-src de la CSP.
NEXT_PUBLIC_MEDIA_ORIGIN=

# --- Captura de errores del navegador (Sentry) ----------------------------------
# DSN público del proyecto de Sentry del frontend. Vacío: no se carga el SDK ni
# se envía nada. Con valor: se cargan los errores sin datos personales y el
# origen de ingesta se agrega a connect-src de la CSP.
NEXT_PUBLIC_SENTRY_DSN=

# --- Política de seguridad de contenido (CSP) ----------------------------------
# Por defecto la CSP se envía como Content-Security-Policy-Report-Only (solo
# reporta, no bloquea). Cambie a "false" para aplicarla cuando la autora haya
# validado en producción que no hay violaciones.
CSP_REPORT_ONLY=true

# URL opcional que recibe los reportes de violaciones de la CSP (report-uri).
CSP_REPORT_URI=

# --- Scripts del contrato (opcional) -------------------------------------------
# Ruta al openapi.json del backend para npm run generate:api / check:api
# (relativa a la raíz de este repositorio o absoluta). Vacía: se usa
# ../ventylab-server/openapi/openapi.json. Si se define y el archivo no existe,
# el script falla (la CI la usa con el backend clonado en .ci/ventylab-server).
BACKEND_SPEC_PATH=
